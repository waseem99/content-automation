{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"agent/p101-p103-local-operator-runtime\" ]; then exit 0; fi; git diff --quiet HEAD^ HEAD -- web/static-creator-ui package.json scripts/build-static-creator-ui.js vercel.json .vercelignore",
  "installCommand": "",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/sample-brief.json",
      "destination": "/sample-brief.json"
    },
    {
      "source": "/wordpress-embed.html",
      "destination": "/wordpress-embed.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
