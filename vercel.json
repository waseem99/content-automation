{
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/static-creator-ui/index.html"
    },
    {
      "source": "/app",
      "destination": "/web/static-creator-ui/index.html"
    },
    {
      "source": "/sample-brief.json",
      "destination": "/web/static-creator-ui/sample-brief.json"
    },
    {
      "source": "/wordpress-embed.html",
      "destination": "/web/static-creator-ui/wordpress-embed.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/web/static-creator-ui/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
