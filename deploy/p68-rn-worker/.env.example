# Use a reviewed ComfyUI commit. Never deploy from an unpinned moving branch.
COMFYUI_REF=
WAN22_REVISION=
WAN21_REVISION=
RN_BIND_ADDRESS=127.0.0.1
RN_COMFYUI_PORT=8188
RN_MODEL_DIR=/srv/p68-rn/models
RN_OUTPUT_DIR=/srv/p68-rn/output
RN_INPUT_DIR=/srv/p68-rn/input
COMFYUI_EXTRA_ARGS=--lowvram

# Application-side configuration (set in content-automation, not ComfyUI).
P68_RN_BASE_URL=http://127.0.0.1:8188
P68_RN_BEARER_TOKEN=
P68_RN_WORKFLOW=deploy/p68-rn-worker/workflows/wan22-ti2v-5b-api.json
P68_RN_GPU_HOURLY_USD=0.00
P68_VIDEO_SOFT_CAP_USD=4.00
P68_VIDEO_HARD_CAP_USD=10.00

# Optional local text-to-image keyframe route. The checkpoint must already be
# installed and its commercial-use terms reviewed before submit.
P68_KEYFRAME_BASE_URL=http://127.0.0.1:8188
P68_KEYFRAME_BEARER_TOKEN=
P68_KEYFRAME_CHECKPOINT=
P68_KEYFRAME_MODEL_LICENSE_TYPE=
P68_KEYFRAME_MODEL_LICENSE_URL=
P68_KEYFRAME_GPU_HOURLY_USD=0.00
P68_KEYFRAME_SOFT_CAP_USD=2.00
P68_KEYFRAME_HARD_CAP_USD=5.00
