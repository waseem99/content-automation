# Production-safe example configuration.
# Do not place real secrets in this file.

# PostgreSQL platform foundation
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=20
DATABASE_POOL_TIMEOUT_SEC=15
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=content-automation-operator-production
DATABASE_MIGRATIONS_DIR=migrations
DATABASE_REQUIRE_SCHEMA=true

# Operator runtime
OPERATOR_RUNTIME_API_HOST=0.0.0.0
OPERATOR_RUNTIME_API_PORT=8000
OPERATOR_RUNTIME_LOG_LEVEL=INFO
OPERATOR_RUNTIME_DEMO_MODE=false
OPERATOR_RUNTIME_DATABASE_REQUIRE_SCHEMA=true
OPERATOR_RUNTIME_DATABASE_MIGRATIONS_DIR=migrations

# Required secrets: provide through secret manager or deployment environment only.
# OPENAI_API_KEY=
# SERPAPI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Model defaults
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_MODEL=eleven_multilingual_v2
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
