# PostgreSQL platform foundation
# Example: postgresql://USER:PASSWORD@localhost:5432/football_brief_dev
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SEC=15
DATABASE_CONNECT_TIMEOUT_SEC=10
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=football-brief-dev
DATABASE_MIGRATIONS_DIR=migrations
DATABASE_REQUIRE_SCHEMA=true

# P5 operator runtime
OPERATOR_RUNTIME_API_HOST=127.0.0.1
OPERATOR_RUNTIME_API_PORT=8000
OPERATOR_RUNTIME_LOG_LEVEL=INFO
OPERATOR_RUNTIME_DEMO_MODE=false
OPERATOR_RUNTIME_DATABASE_REQUIRE_SCHEMA=true
OPERATOR_RUNTIME_DATABASE_MIGRATIONS_DIR=migrations
OPERATOR_RUNTIME_AUTO_CONNECT_DATABASE=false

# Protected operator API access. JSON maps secret keys to non-secret operator IDs.
# Keep empty for an intentionally inaccessible API; never commit real keys.
OPERATOR_API_KEYS_JSON=

# Comma-separated exact dashboard origins. Never use *.
OPERATOR_CORS_ORIGINS=

# OpenAI (script generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SerpAPI (web image search — Creative Commons / Wikimedia filtered)
SERPAPI_API_KEY=
# IMAGE_LICENSE_FILTER=sur:cl

# ElevenLabs (voiceover) — use a voice from YOUR account (run: python -m src.cli list-voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Background music (optional)
# BG_MUSIC_PATH=data/assets/background.mp3
# BG_MUSIC_VOLUME=0.12

# Whisper (clip extraction)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Explainer pipeline — GPT image (good quality, controlled cost)
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
# Cheaper demo preset: OPENAI_IMAGE_SIZE=1024x1024 and OPENAI_IMAGE_QUALITY=low
# MAX_STILL_BEAT_SEC=4.0
# HOOK_BEAT_SEC=0.7
# CAPTION_MODE=keyword

# P68 RN GPU video worker (headless ComfyUI + Wan 2.2)
P68_RN_BASE_URL=
P68_RN_BEARER_TOKEN=
P68_RN_WORKFLOW=deploy/p68-rn-worker/workflows/wan22-ti2v-5b-api.json
P68_RN_GPU_HOURLY_USD=0.00
P68_VIDEO_SOFT_CAP_USD=4.00
P68_VIDEO_HARD_CAP_USD=10.00

# P75 reference intelligence (local/private worker only; paths, never cookie contents)
REFINTEL_WORKSPACE=
REFINTEL_FACEBOOK_PROFILE=
REFINTEL_FACEBOOK_COOKIE_FILE=
REFINTEL_COOKIES_FROM_BROWSER=
REFINTEL_USE_OLLAMA=0
REFINTEL_OLLAMA_MODEL=qwen2.5vl:7b
REFINTEL_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
