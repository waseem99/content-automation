{
  "name": "content-automation-video-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local Remotion video engine with paid and no-cost local narration providers.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "validate": "node scripts/validate-project.mjs samples/rawr-nation-army-ants.json",
    "voice": "node scripts/generate-voice.mjs samples/rawr-nation-army-ants.json",
    "voice:project": "node scripts/generate-voice.mjs",
    "voice:kokoro": "VOICE_PROVIDER=kokoro node scripts/generate-voice.mjs",
    "voice:elevenlabs": "VOICE_PROVIDER=elevenlabs node scripts/generate-voice.mjs",
    "render": "node scripts/render.mjs samples/rawr-nation-army-ants.json",
    "render:project": "node scripts/render.mjs",
    "validate:p67": "node scripts/validate-project.mjs samples/rawr-nation-blind-spot.json && node scripts/validate-project.mjs samples/animal-x-elephant-ground-signals.json"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  }
}
